DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://eyhzawffavhmdsxzphek.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# The bundled Swiss Ephemeris data location in the Cloud Run image.
EPHEMERIS_PATH=/app/ephe
