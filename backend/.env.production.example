APP_NAME=Vedic Horoscope API
ENVIRONMENT=production
API_V1_PREFIX=/api/v1
CORS_ORIGINS=https://REPLACE_WITH_APP_HOSTING_DOMAIN

# Supabase Session Pooler. Use the exact production pooler URL with the
