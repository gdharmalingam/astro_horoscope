# Application
APP_NAME=Vedic Horoscope API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql+psycopg://horoscope:horoscope@localhost:5432/horoscope

# Supabase
# The browser uses the project URL and anon key; the API only needs the URL to verify JWTs via JWKS.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# Swiss Ephemeris data files directory (mounted into the container)
EPHEMERIS_PATH=./ephe
